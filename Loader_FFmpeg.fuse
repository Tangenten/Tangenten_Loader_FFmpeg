local RUNNING_IN_FUSION = FuRegisterClass ~= nil

local TOOL_ID = "Loader_FFmpeg"
local TOOL_TYPE = CT_Tool
local TOOL_NAME = "Loader (FFmpeg)"
local TOOL_DESCRIPTION = "Loads video frames through fuse-local FFmpeg/libav libraries"
local TOOL_ABBREVIATION = "LDFF"
local TOOL_DEVELOPER = "Tangenten"
local TOOL_DEVELOPER_WEBSITE = "https://tangenten.xyz"
local TOOL_VERSION = "1.0.0"

local TOOL_PUBLISHED = true
local TOOL_ENABLE_LOGGING = not TOOL_PUBLISHED
local TOOL_RUN_TESTS_ON_STARTUP = not TOOL_PUBLISHED

local OUTPUT_FORMAT_UINT8 = 0
local OUTPUT_FORMAT_FLOAT32 = 1
local OUTPUT_SCALE_FULL = 0
local OUTPUT_SCALE_HALF = 1
local OUTPUT_SCALE_QUARTER = 2
local OUTPUT_SCALE_EIGHTH = 3
local INTERPOLATION_NEAREST = 0
local INTERPOLATION_LINEAR = 1

LOADER_LIBAV = LOADER_LIBAV
LOADER_LIBAV_ERROR = LOADER_LIBAV_ERROR
LOADER_DECODER = LOADER_DECODER
LOADER_DECODER_PATH = LOADER_DECODER_PATH
LOADER_STATUS_HTML = LOADER_STATUS_HTML
LOADER_INFO_STATUS_KEY = LOADER_INFO_STATUS_KEY

--region Logging
local function stringifyArgs(...)
	local parts = {}
	for i = 1, select("#", ...) do
		local v = select(i, ...)
		if type(v) == "table" then
			local tableParts = {}
			for k, value in pairs(v) do
				tableParts[#tableParts + 1] = tostring(k) .. "=" .. tostring(value)
			end
			parts[i] = "{" .. table.concat(tableParts, ", ") .. "}"
		else
			parts[i] = tostring(v)
		end
	end

	return table.concat(parts, " ")
end

-- Fusion's global dump() prints each argument on its own console line. Route
-- logs through a single concatenated print so each entry stays on one line.
local function logLine(...)
	print("[" .. TOOL_NAME .. "] " .. stringifyArgs(...))
end

local function logEnabled()
	return TOOL_ENABLE_LOGGING
end

local function logInfo(...)
	if not logEnabled() then return end
	logLine(...)
end

local function logCritical(...)
	logLine(...)
end

local function logError(...)
	error("[" .. TOOL_NAME .. "] " .. stringifyArgs(...), 2)
end

local function logAssert(condition, ...)
	if not condition then
		logError(...)
	end
end
--endregion Logging

--region Paths
local function getPathSeparator()
	return package.config:sub(1, 1)
end

local function getFuseDir()
	local sourceFile = debug.getinfo(1).source
	if sourceFile:sub(1, 1) == "@" then
		sourceFile = sourceFile:sub(2)
	end

	local fuseDir = sourceFile:match("^(.+)[/\\][^/\\]+$")
	if fuseDir then
		return fuseDir
	end

	logError("Fuse dir not found")
end

local function fileExists(path)
	if not path or path == "" then
		return false
	end

	local f = io.open(path, "rb")
	if f then
		f:close()
		return true
	end

	return false
end

local function mapCompPath(comp, path)
	if not path or path == "" then
		logInfo("[path] Empty input path")
		return ""
	end

	if comp and comp.MapPath then
		local ok, mapped = pcall(function()
			return comp:MapPath(path)
		end)
		if ok and mapped and mapped ~= "" then
			if mapped ~= path then
				logInfo("[path] Mapped", path, "->", mapped)
			else
				logInfo("[path] Path did not need mapping", path)
			end
			return mapped
		end
		if not ok then
			logInfo("[path] MapPath failed, using raw path:", tostring(mapped))
		end
	end

	logInfo("[path] Using raw path", path)
	return path
end
--endregion Paths

--region Pure helpers
local function clamp(v, lo, hi)
	if v < lo then return lo end
	if v > hi then return hi end
	return v
end

local function umod(a, n)
	if n <= 0 then return 0 end
	local r = a % n
	if r < 0 then r = r + n end
	return r
end

local function pingpong(i, n)
	if n <= 1 then return 0 end
	local len = (n * 2) - 2
	local m = umod(i, len)
	if m >= n then return len - m end
	return m
end

local function roundToInt(v)
	return math.floor(v + 0.5)
end

local function getCompFrameRate(comp)
	local fps
	if comp then
		local ok, v = pcall(function() return comp:GetPrefs("Comp.FrameFormat.Rate") end)
		if ok and type(v) == "number" and v > 0 then fps = v end

		if not fps then
			local ok2, t = pcall(function() return comp:GetPrefs("Comp.FrameFormat") end)
			if ok2 and type(t) == "table" and type(t.Rate) == "number" and t.Rate > 0 then
				fps = t.Rate
			end
		end

		if not fps then
			local ok3, attrs = pcall(function() return comp:GetAttrs() end)
			if ok3 and type(attrs) == "table" then
				if type(attrs.COMPN_GlobalFPS) == "number" and attrs.COMPN_GlobalFPS > 0 then
					fps = attrs.COMPN_GlobalFPS
				elseif type(attrs.COMPN_FrameRate) == "number" and attrs.COMPN_FrameRate > 0 then
					fps = attrs.COMPN_FrameRate
				end
			end
		end
	end

	return (type(fps) == "number" and fps > 0) and fps or 24.0
end

-- Playback is anchored to the global timeline, independent of the render range.
local function getCompGlobalStart(comp)
	if not comp then return 0 end
	return comp.GlobalStart
end

local function escapeHtml(text)
	text = tostring(text or "")
	text = text:gsub("&", "&amp;")
	text = text:gsub("<", "&lt;")
	text = text:gsub(">", "&gt;")
	text = text:gsub('"', "&quot;")
	return text
end

local function formatSeconds(seconds)
	if not seconds or seconds <= 0 then
		return "unknown"
	end

	return string.format("%.3fs", seconds)
end

local function formatFps(fps)
	if not fps or fps <= 0 then
		return "unknown"
	end

	return string.format("%.6g", fps)
end

local function getInfoFrameCount(info)
	if not info then return 0 end
	if info.frameCount and info.frameCount > 0 then
		return roundToInt(info.frameCount)
	end
	if info.duration and info.duration > 0 and info.fps and info.fps > 0 then
		return math.max(1, roundToInt(info.duration * info.fps))
	end

	return 0
end

local function computeFrameIndex(req, info, comp)
	local frameCount = getInfoFrameCount(info)
	if frameCount <= 0 then
		logInfo("[frame-map] Unknown frame count; using frame 0", "time", req.Time)
		return 0, false
	end

	local maxFrame = frameCount - 1
	local playbackSpeed = InPlaybackSpeed:GetValue(req).Value or 1.0
	local reverse = (InReverse:GetValue(req).Value or 0) >= 0.5
	local loopMode = math.floor((InLoopMode:GetValue(req).Value or 0) + 0.5)
	local startBehaviour = math.floor((InStartBehaviour:GetValue(req).Value or 0) + 0.5)
	local startFrame = math.max(0, roundToInt(InStartFrame:GetValue(req).Value or 0))
	local endFrame = math.max(0, roundToInt(InEndFrame:GetValue(req).Value or 0))
	local startOffset = math.max(0, roundToInt(InStartOffset:GetValue(req).Value or 0))

	-- End Frame is seeded from the clip on load; the 0 fallback below is kept
	-- only as a safety net for unseeded states (e.g. a comp opened with a path
	-- already set), so a stray 0 means "whole clip", not a single frame.
	local startIdx = clamp(startFrame, 0, maxFrame)
	local endIdx = endFrame == 0 and maxFrame or clamp(endFrame - 1, startIdx, maxFrame)
	local subsetFrameCount = math.max(1, endIdx - startIdx + 1)

	local idxInSubset = 0
	local interpolation = 0
	local blank = false
	local compFps = getCompFrameRate(comp)
	local compStart = getCompGlobalStart(comp)
	local sourceFps = info.fps and info.fps > 0 and info.fps or compFps
	local rate = sourceFps * playbackSpeed
	local compTime = (req.Time or compStart) - compStart
	local logicalPosition = (compTime - startOffset) * (rate / compFps)
	logInfo("[frame-map] Auto inputs", "time", req.Time, "compStart", compStart, "compTime", compTime, "startOffset",
		startOffset, "compFps", compFps, "sourceFps", sourceFps, "playbackSpeed", playbackSpeed, "rate", rate, "logical",
		logicalPosition, "loopMode", loopMode, "reverse", reverse, "range", startIdx .. "-" .. endIdx)

	if compTime < startOffset then
		if startBehaviour == 0 then
			-- Blank before the start offset.
			blank = true
		else
			-- Hold the first frame of the configured playback direction.
			idxInSubset = 0
		end
	elseif loopMode == 2 then
		local cycle = subsetFrameCount
		local cyclePosition = logicalPosition - math.floor(logicalPosition / cycle) * cycle
		idxInSubset = math.floor(cyclePosition)
		interpolation = cyclePosition - idxInSubset
	elseif loopMode == 3 then
		if subsetFrameCount == 1 then
			idxInSubset = 0
		else
			local cycle = 2 * (subsetFrameCount - 1)
			local cyclePosition = logicalPosition - math.floor(logicalPosition / cycle) * cycle
			if cyclePosition <= subsetFrameCount - 1 then
				idxInSubset = math.floor(cyclePosition)
				interpolation = cyclePosition - idxInSubset
			else
				local reflected = cycle - cyclePosition
				idxInSubset = math.floor(reflected)
				interpolation = reflected - idxInSubset
			end
		end
	elseif loopMode == 1 then
		local clampedPosition = math.min(logicalPosition, subsetFrameCount - 1)
		idxInSubset = math.floor(clampedPosition)
		interpolation = clampedPosition - idxInSubset
	else
		if logicalPosition >= subsetFrameCount then
			blank = true
		else
			idxInSubset = math.floor(logicalPosition)
			interpolation = logicalPosition - idxInSubset
		end
	end

	local nextIdx = math.min(subsetFrameCount - 1, idxInSubset + 1)
	if loopMode == 2 and idxInSubset == subsetFrameCount - 1 then
		nextIdx = 0
	end
	if reverse then
		idxInSubset = subsetFrameCount - 1 - idxInSubset
		nextIdx = subsetFrameCount - 1 - nextIdx
	end
	local frameIndex = startIdx + idxInSubset
	local nextFrameIndex = startIdx + nextIdx
	local interpolationMode = InInterpolationMode and math.floor((InInterpolationMode:GetValue(req).Value or 0) + 0.5) or
	INTERPOLATION_NEAREST
	if interpolationMode ~= INTERPOLATION_LINEAR then
		interpolation = 0
	end
	logInfo("[frame-map] Result", "time", req.Time, "frameIndex", frameIndex, "nextFrameIndex", nextFrameIndex,
		"interpolation", interpolation, "idxInSubset", idxInSubset, "subsetFrameCount", subsetFrameCount, "blank", blank)
	return frameIndex, blank, nextFrameIndex, interpolation
end

if rawget and rawget(_G, "__TLAV_TEST") then
	_G.__TLAV_COMPUTE_FRAME_INDEX = computeFrameIndex
end
--endregion Pure helpers

--region LibAV state
local function closeDecoder()
	if LOADER_DECODER and LOADER_DECODER.close then
		logInfo("[decode] Closing decoder", LOADER_DECODER_PATH or "<unknown>")
		local ok, err = pcall(function()
			LOADER_DECODER:close()
		end)
		if not ok then
			logInfo("[decode] close failed:", tostring(err))
		end
	end

	LOADER_DECODER = nil
	LOADER_DECODER_PATH = nil
	logInfo("[decode] Decoder state cleared")
end

local function loadLibAV()
	if LOADER_LIBAV then
		local ok, version = pcall(function()
			return LOADER_LIBAV.version()
		end)
		if ok then
			logInfo("[libav] Reusing loaded bridge", version, "path", LOADER_LIBAV.bridgePath or "<unknown>")
			return LOADER_LIBAV
		end

		logInfo("[libav] Cached bridge is invalid; rebuilding", tostring(version))
		LOADER_LIBAV = nil
		closeDecoder()
	end
	if LOADER_LIBAV_ERROR then
		logInfo("[libav] Returning cached bridge error", LOADER_LIBAV_ERROR)
		return nil, LOADER_LIBAV_ERROR
	end

	local sep = getPathSeparator()
	local ffiPath = getFuseDir() .. sep .. "LibAV" .. sep .. "LibAV_FFI.lua"
	logInfo("[libav] Loading FFI wrapper", ffiPath)
	local ok, buildLibAV = pcall(dofile, ffiPath)
	if not ok then
		LOADER_LIBAV_ERROR = "Failed to load LibAV_FFI.lua: " .. tostring(buildLibAV)
		logInfo("[libav] FFI wrapper failed", LOADER_LIBAV_ERROR)
		return nil, LOADER_LIBAV_ERROR
	end

	logInfo("[libav] Building bridge from fuse dir", getFuseDir())
	local libAV, err = buildLibAV(getFuseDir())
	if not libAV then
		LOADER_LIBAV_ERROR = tostring(err)
		logInfo("[libav] Bridge build failed", LOADER_LIBAV_ERROR)
		return nil, LOADER_LIBAV_ERROR
	end

	LOADER_LIBAV = libAV
	local versionOk, version = pcall(function()
		return libAV.version()
	end)
	if not versionOk then
		LOADER_LIBAV = nil
		LOADER_LIBAV_ERROR = "LibAV bridge loaded but version check failed: " .. tostring(version)
		logInfo("[libav] Bridge version check failed", LOADER_LIBAV_ERROR)
		return nil, LOADER_LIBAV_ERROR
	end

	logInfo("[libav] Loaded", version, "dir", libAV.libDir or "<unknown>", "bridge", libAV.bridgePath or "<unknown>")
	return LOADER_LIBAV
end

local function ensureDecoder(path)
	if LOADER_DECODER and LOADER_DECODER_PATH == path then
		logInfo("[decode] Reusing decoder", path)
		return LOADER_DECODER
	end

	closeDecoder()

	local libAV, err = loadLibAV()
	if not libAV then
		return nil, err
	end

	local decoder, openErr = libAV.open(path)
	if not decoder then
		logInfo("[decode] Open failed", path, openErr, "bridgeDebug", libAV.lastDebug and libAV.lastDebug() or "")
		return nil, openErr
	end

	LOADER_DECODER = decoder
	LOADER_DECODER_PATH = path
	logInfo("[decode] Opened", path, "bridgeDebug", libAV.lastDebug and libAV.lastDebug() or "")
	logInfo("[decode] Metadata", "width", decoder.info.width, "height", decoder.info.height, "fps", decoder.info.fps,
		"frames", decoder.info.frameCount, "duration", decoder.info.duration, "codec", decoder.info.codecName, "pix",
		decoder.info.pixelFormat, "format", decoder.info.formatName)
	return LOADER_DECODER
end
--endregion LibAV state

--region Fusion image/status
local function makeStatusHtml(title, lines, isError)
	local color = isError and "#c8896a" or "#9fb7c9"
	local html = "<span style='color:" .. color .. ";'><b>" .. escapeHtml(title) .. "</b>"
	for i = 1, #lines do
		html = html .. "<br>" .. escapeHtml(lines[i])
	end
	return html .. "</span>"
end

local function setStatusHtml(html)
	if not RUNNING_IN_FUSION or not InMetadataStatus then
		return
	end
	if LOADER_STATUS_HTML == html then
		return
	end

	LOADER_STATUS_HTML = html
	logInfo("[status] Updating metadata label")
	InMetadataStatus:SetAttrs({ LINKS_Name = html })
end

local function libAVVersion()
	if not LOADER_LIBAV or not LOADER_LIBAV.version then return "not loaded" end

	local ok, version = pcall(function()
		return LOADER_LIBAV.version()
	end)
	if not ok then return "unavailable: " .. tostring(version) end

	return version
end

local function setInfoStatus(info, path, runtime)
	local frameCount = getInfoFrameCount(info)
	local key = table.concat({
		tostring(path),
		tostring(info.width or 0),
		tostring(info.height or 0),
		tostring(info.fps or 0),
		tostring(frameCount),
		tostring(info.duration or 0),
		tostring(info.codecName or ""),
		tostring(info.pixelFormat or ""),
		tostring(info.hwAccel or ""),
		runtime and tostring(runtime.decodePath or "") or "",
		runtime and tostring(runtime.outputFormat or "") or "",
		runtime and tostring(runtime.outputScaling or "") or "",
		runtime and tostring(runtime.outputSize or "") or "",
		runtime and tostring(runtime.stride or "") or "",
		runtime and tostring(runtime.fallbackReason or "") or "",
	}, "\31")
	if LOADER_INFO_STATUS_KEY == key then
		return
	end

	local lines = {
		string.format("Path: %s", path),
		string.format("Resolution: %d x %d", info.width or 0, info.height or 0),
		string.format("Frame rate: %s", formatFps(info.fps)),
		string.format("Frames: %s", frameCount > 0 and tostring(frameCount) or "unknown"),
		string.format("Duration: %s", formatSeconds(info.duration)),
		string.format("Codec: %s", info.codecName ~= "" and info.codecName or "unknown"),
		string.format("Pixel format: %s", info.pixelFormat ~= "" and info.pixelFormat or "unknown"),
		string.format("Decoding: %s",
			(info.hwAccel and info.hwAccel ~= "") and ("Hardware (" .. string.upper(info.hwAccel) .. ")") or "Software"),
	}

	if runtime then
		lines[#lines + 1] = ""
		lines[#lines + 1] = string.format("Runtime: %s", runtime.decodePath or "unknown")
		if runtime.outputFormat then
			lines[#lines + 1] = string.format("Output format: %s", runtime.outputFormat)
		end
		if runtime.outputScaling then
			lines[#lines + 1] = string.format("Output scaling: %s", runtime.outputScaling)
		end
		lines[#lines + 1] = string.format("Bridge: %s", libAVVersion())
		if LOADER_LIBAV and LOADER_LIBAV.bridgePath then
			lines[#lines + 1] = string.format("Bridge path: %s", LOADER_LIBAV.bridgePath)
		end
		if runtime.outputSize then
			lines[#lines + 1] = string.format("Output: %s", runtime.outputSize)
		end
		if runtime.stride then
			lines[#lines + 1] = string.format("Stride: %s", tostring(runtime.stride))
		end
		if runtime.fallbackReason and runtime.fallbackReason ~= "" then
			lines[#lines + 1] = string.format("Fallback: %s", runtime.fallbackReason)
		end
	end

	LOADER_INFO_STATUS_KEY = key
	setStatusHtml(makeStatusHtml("Video loaded", lines, false))
end

local function setErrorStatus(title, detail)
	LOADER_INFO_STATUS_KEY = nil
	setStatusHtml(makeStatusHtml(title, { tostring(detail or "") }, true))
end

local function getOutputFormat(req)
	if not InOutputFormat then
		return OUTPUT_FORMAT_UINT8, 5, 4, "UInt8 RGBA"
	end

	local value = InOutputFormat:GetValue(req)
	local format = math.floor(((value and value.Value) or 0) + 0.5)
	if format == OUTPUT_FORMAT_FLOAT32 then
		return OUTPUT_FORMAT_FLOAT32, 8, 16, "Float32 RGBA"
	end

	return OUTPUT_FORMAT_UINT8, 5, 4, "UInt8 RGBA"
end

local function getOutputScale(req)
	if not InOutputScale then
		return 1, "1/1"
	end

	local value = InOutputScale:GetValue(req)
	local scale = math.floor(((value and value.Value) or OUTPUT_SCALE_FULL) + 0.5)
	if scale == OUTPUT_SCALE_HALF then
		return 2, "1/2"
	elseif scale == OUTPUT_SCALE_QUARTER then
		return 4, "1/4"
	elseif scale == OUTPUT_SCALE_EIGHTH then
		return 8, "1/8"
	end

	return 1, "1/1"
end

local function getOutputDimensions(info, req)
	local scale = getOutputScale(req)
	local width = math.max(1, math.floor((info.width or 1) / scale))
	local height = math.max(1, math.floor((info.height or 1) / scale))
	return width, height
end

local function createImage(tool, req, width, height, noData, depth)
	local attrs = {
		IMG_Document = tool.Comp,
		{ IMG_Channel = "Red" },
		{ IMG_Channel = "Green" },
		{ IMG_Channel = "Blue" },
		{ IMG_Channel = "Alpha" },
		IMG_Width = math.max(1, math.floor(width or 1)),
		IMG_Height = math.max(1, math.floor(height or 1)),
		IMG_Depth = depth or 5,
		IMG_XScale = 1.0,
		IMG_YScale = 1.0,
		IMG_Quality = not req:IsQuick(),
		IMG_MotionBlurQuality = not req:IsNoMotionBlur(),
	}

	if noData then
		attrs.IMG_NoData = true
	end

	return Image(attrs)
end

local function setNoDataOutput(tool, req, width, height)
	logInfo("[image] Output no-data", "time", req.Time, "size", tostring(width or 1) .. "x" .. tostring(height or 1))
	local _, depth = getOutputFormat(req)
	OutImage:Set(req, createImage(tool, req, width or 1, height or 1, true, depth))
end

-- A genuinely empty (transparent) frame. IMG_NoData is a precalc-only header
-- with no pixel memory; as a real Process output the viewer shows nothing new
-- and keeps the previous frame. Allocate and clear so the viewer truly blanks.
local function setBlankOutput(tool, req, width, height)
	local _, depth = getOutputFormat(req)
	local img = createImage(tool, req, width or 1, height or 1, false, depth)
	img:Clear()
	logInfo("[image] Output blank", "time", req.Time, "size", tostring(width or 1) .. "x" .. tostring(height or 1))
	OutImage:Set(req, img)
end

local function sampleBytes(ptr, byteCount)
	if not TOOL_ENABLE_LOGGING then return 0 end
	if not LOADER_LIBAV or not LOADER_LIBAV.ffi or ptr == nil then
		return 0
	end

	local ffi = LOADER_LIBAV.ffi
	if ptr == ffi.NULL then
		return 0
	end

	local data = ffi.cast("const uint8_t*", ptr)
	local limit = math.min(tonumber(byteCount) or 0, 4096)
	local sample = 0
	for i = 0, limit - 1 do
		sample = (sample + tonumber(data[i]) * ((i % 31) + 1)) % 1000000007
	end

	return sample
end

local function copyFrameToImage(outImg, frame, outputWidth, outputHeight)
	local ffi = LOADER_LIBAV.ffi
	local width = tonumber(frame.width) or 0
	local height = tonumber(frame.height) or 0
	local stride = tonumber(frame.stride) or 0
	local byteCount = stride * height
	if width ~= outputWidth or height ~= outputHeight or width <= 0 or height <= 0 or stride < width * 4 or frame.data == nil or frame.data == ffi.NULL then
		return false,
				"Invalid frame dimensions " .. tostring(width) .. "x" .. tostring(height) .. " stride " .. tostring(stride)
	end

	-- GetScanLine() returns a live, writable array of row pointers into the
	-- buffered fallback image's 8-bit RGBA memory.
	local rawScanlines = outImg:GetScanLine()
	if rawScanlines == nil then
		return false, "Image:GetScanLine returned nil"
	end
	local scanlines = ffi.cast("uint8_t **", rawScanlines)
	if scanlines == ffi.NULL then
		return false, "Image:GetScanLine returned a null pointer"
	end

	-- Fusion stores scanlines bottom-up (scanlines[0] = bottom row); the libav
	-- frame is top-down (row 0 = top). Map image scanline y <- source row
	-- (height-1-y) so the picture lands right-side up, writing every row.
	local srcData = ffi.cast("const uint8_t*", frame.data)
	local rowBytes = width * 4
	for y = 0, height - 1 do
		if scanlines[y] == ffi.NULL then return false, "Image scanline is null" end
		ffi.copy(scanlines[y], srcData + ((height - 1 - y) * stride), rowBytes)
	end

	logInfo("[image] Wrote scanlines", "frame", tonumber(frame.frame_index), "size", width .. "x" .. height, "stride",
		stride, "rowBytes", rowBytes, "srcPtr", tostring(frame.data), "srcSample", sampleBytes(frame.data, byteCount))
	return true
end

local function getDirectImageTarget(outImg, width, height, bytesPerPixel)
	local ffi = LOADER_LIBAV and LOADER_LIBAV.ffi
	if not ffi then return nil, nil, "LibAV FFI unavailable" end
	if not outImg.GetScanLine then return nil, nil, "Fusion Image:GetScanLine is unavailable" end

	local rawScanlines = outImg:GetScanLine()
	if rawScanlines == nil then
		return nil, nil, "Image:GetScanLine returned nil"
	end

	local scanlines = ffi.cast("uint8_t **", rawScanlines)
	if scanlines == ffi.NULL then
		return nil, nil, "Image:GetScanLine returned a null pointer"
	end

	local rowBytes = width * bytesPerPixel
	local topRow = scanlines[height - 1]
	if topRow == nil or topRow == ffi.NULL then
		return nil, nil, "Top scanline is null"
	end
	if height == 1 then
		return topRow, rowBytes, nil
	end

	local secondRow = scanlines[height - 2]
	if secondRow == nil or secondRow == ffi.NULL then
		return nil, nil, "Second scanline is null"
	end

	local stride = tonumber(secondRow - topRow)
	if not stride or math.abs(stride) < rowBytes then
		return nil, nil, "Scanline stride is too small"
	end

	for y = 0, height - 1 do
		local expected = topRow + ((height - 1 - y) * stride)
		if scanlines[y] ~= expected then
			return nil, nil, "Scanlines are not contiguous"
		end
	end

	return topRow, stride, nil
end

local function decodeFrameIntoImage(decoder, frameIndex, outImg, outputFormat, bytesPerPixel, outputWidth, outputHeight)
	if not decoder.decodeInto then
		return nil, "LibAV bridge does not expose direct image decode"
	end
	if outputFormat ~= OUTPUT_FORMAT_UINT8 and not decoder.decodeIntoFormat then
		return nil, "LibAV bridge does not expose formatted direct image decode"
	end

	local width = outputWidth or math.max(1, math.floor(decoder.info.width or 1))
	local height = outputHeight or math.max(1, math.floor(decoder.info.height or 1))
	if not decoder.decodeIntoScaled and (width ~= decoder.info.width or height ~= decoder.info.height) then
		return nil, "Update the LibAV bridge to decode scaled images"
	end
	local dst, stride, targetErr = getDirectImageTarget(outImg, width, height, bytesPerPixel or 4)
	if not dst then
		return nil, targetErr
	end

	local frame, decodeErr
	if decoder.decodeIntoScaled then
		frame, decodeErr = decoder:decodeIntoScaled(frameIndex, dst, stride, outputFormat, width, height)
	elseif outputFormat == OUTPUT_FORMAT_UINT8 then
		frame, decodeErr = decoder:decodeInto(frameIndex, dst, stride)
	else
		frame, decodeErr = decoder:decodeIntoFormat(frameIndex, dst, stride, outputFormat)
	end
	if not frame then
		return nil, decodeErr
	end

	logInfo("[image] Direct decode", "frame", tonumber(frame.frame_index), "size",
		tonumber(frame.width) .. "x" .. tonumber(frame.height), "stride", tonumber(frame.stride), "dst", tostring(dst))
	return frame, nil
end

local function decodeFrameToImage(decoder, frameIndex, outImg, outputFormat, bytesPerPixel, outputWidth, outputHeight)
	local frame, directErr = decodeFrameIntoImage(decoder, frameIndex, outImg, outputFormat, bytesPerPixel, outputWidth,
		outputHeight)
	if frame then
		return frame, "Direct to Fusion image", nil
	end
	if outputFormat ~= OUTPUT_FORMAT_UINT8 then
		return nil, nil, directErr
	end
	if outputWidth ~= decoder.info.width or outputHeight ~= decoder.info.height then
		return nil, nil, directErr
	end

	local fallbackFrame, decodeErr = decoder:decode(frameIndex)
	if not fallbackFrame then
		return nil, nil, decodeErr or directErr
	end
	local ok, copyErr = copyFrameToImage(outImg, fallbackFrame, outputWidth, outputHeight)
	if not ok then
		return nil, nil, copyErr
	end
	return fallbackFrame, "Buffered fallback", directErr
end

local function blendImages(dstImg, srcImg, width, height, bytesPerPixel, factor)
	-- Both images were decoded through GetScanLine(), so their CPU buffers are
	-- authoritative here. DownloadGPUMem() at this point can restore stale GPU
	-- pixels and is the source of visible flicker during interpolation.
	local dst, dstStride, dstErr = getDirectImageTarget(dstImg, width, height, bytesPerPixel)
	if not dst then return false, dstErr end
	local src, srcStride, srcErr = getDirectImageTarget(srcImg, width, height, bytesPerPixel)
	if not src then return false, srcErr end

	local outputFormat = bytesPerPixel == 4 and OUTPUT_FORMAT_UINT8 or OUTPUT_FORMAT_FLOAT32
	return LOADER_LIBAV.blendRgba(dst, dstStride, src, srcStride, width, height, outputFormat, factor)
end
--endregion Fusion image/status

