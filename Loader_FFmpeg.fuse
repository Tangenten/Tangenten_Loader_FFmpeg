--region NotifyChanged
local function resetButton(input)
	if input and Number then
		input:SetSource(Number(0), 0, 0)
	end
end

local function getStaticSourceValue(input, defaultValue)
	if not input or not input.GetSource then return defaultValue end

	local ok, source = pcall(function()
		if REQF_SecondaryTime then
			return input:GetSource(0, REQF_SecondaryTime, REQF_SecondaryTime)
		end

		return input:GetSource(0)
	end)
	if not ok or not source then return defaultValue end

	return source.Value
end

-- Read clip metadata with a throwaway decoder handle. This stays separate from
-- the shared LOADER_DECODER (used by Process on another thread) so probing from
-- the UI thread never races the render decoder.
local function probeClipInfo(comp, rawPath)
	local mapped = mapCompPath(comp, rawPath or "")
	if mapped == "" or not fileExists(mapped) then
		return nil, mapped
	end

	local libAV = loadLibAV()
	if not libAV then return nil, mapped end

	local probe, err = libAV.open(mapped)
	if not probe then
		logInfo("[defaults] Probe open failed", mapped, tostring(err))
		return nil, mapped
	end

	local info = probe.info
	probe:close()
	return info, mapped
end

-- On a freshly loaded clip, seed End Frame from the source so both the live
-- value and the reset default match the clip, and grow the slider scale so the
-- new value stays reachable. Playback Speed stays at the user's multiplier; the
-- actual rate comes from the clip's own fps in computeFrameIndex.
local function applyClipDefaults(info, seedEndFrame)
	if not info or not Number then return end

	local frameCount = getInfoFrameCount(info)
	if frameCount > 0 and InEndFrame then
		local maxScale = math.max(frameCount, 1)
		if InStartFrame then InStartFrame:SetAttrs({ INP_MaxScale = maxScale }) end
		InEndFrame:SetAttrs({ INP_Default = frameCount, INP_MaxScale = maxScale })
		if seedEndFrame then
			InEndFrame:SetSource(Number(frameCount), 0, 0)
		end
		logInfo("[defaults] EndFrame", "value", frameCount, "maxScale", maxScale, "seed", seedEndFrame)
	end
end

local function seedClipDefaultsFromCurrentPath()
	local inputPath = getStaticSourceValue(InInputPath, "")
	if inputPath == "" then
		logInfo("[defaults] No path to seed")
		return
	end

	local info, mapped = probeClipInfo(self.Comp, inputPath)
	if not info then
		logInfo("[defaults] No clip info to seed", mapped)
		return
	end

	local endFrame = math.max(0, roundToInt(getStaticSourceValue(InEndFrame, 0) or 0))
	applyClipDefaults(info, endFrame == 0)
	setInfoStatus(info, mapped)
end

function NotifyChanged(inp, param, time)
	if not param then return end

	if inp == InVersionFooter or inp == InLicenseFFmpeg then
		if bmd and bmd.openurl and param.Value then
			bmd.openurl(param.Value)
		end
		return
	end

	if inp == InInputPath then
		closeDecoder()
		local info, mapped = probeClipInfo(self.Comp, param.Value)
		if info then
			applyClipDefaults(info, true)
			setInfoStatus(info, mapped)
		else
			LOADER_INFO_STATUS_KEY = nil
			setStatusHtml(makeStatusHtml("Video path changed", { "Render a frame to load metadata." }, false))
		end
		return
	end

	if inp == InReloadBtn and param.Value >= 0.5 then
		closeDecoder()
		seedClipDefaultsFromCurrentPath()
		local execute = string.format([[
local tool = comp:FindTool(%q)
if tool == nil then return end
tool.ScriptReload[fu.TIME_UNDEFINED] = 1
tool.ScriptReload[fu.TIME_UNDEFINED] = 0
]], self.Name)

		local ok, err = pcall(function()
			self.Comp:Execute(execute)
		end)
		if not ok then
			logInfo("[reload] Failed:", tostring(err))
		end
		resetButton(InReloadBtn)
		return
	end

	if inp == InWebsiteBtn and param.Value >= 0.5 then
		if bmd and bmd.openurl then
			bmd.openurl(TOOL_DEVELOPER_WEBSITE)
		end
		resetButton(InWebsiteBtn)
		return
	end
end

--endregion NotifyChanged

--region OnAddToFlow
function OnAddToFlow()
	seedClipDefaultsFromCurrentPath()
	if TOOL_RUN_TESTS_ON_STARTUP then
		Tests()
	end
end

--endregion OnAddToFlow

--region PreCalcProcess
-- Resolve the output resolution without decoding. ensureDecoder caches by path,
-- so the file is opened/probed once and every later precalc is a cheap cache
-- hit; opening only demuxes metadata and never seeks, so it leaves Process's
-- decode position untouched. Returns nil when there is no usable clip yet.
local function resolveVideoSize(req, comp)
	local pathValue = InInputPath and InInputPath:GetValue(req)
	local inputPath = pathValue and pathValue.Value or ""
	local mappedPath = mapCompPath(comp, inputPath)
	if mappedPath == "" or not fileExists(mappedPath) then
		return nil, nil, mappedPath
	end

	local decoder = ensureDecoder(mappedPath)
	if decoder and decoder.info and (decoder.info.width or 0) > 0 and (decoder.info.height or 0) > 0 then
		local width, height = getOutputDimensions(decoder.info, req)
		return width, height, mappedPath, decoder
	end

	return nil, nil, mappedPath
end

function PreCalcProcess(req)
	local width, height = resolveVideoSize(req, self.Comp)
	logInfo("[precalc] Output size", "width", width or 1, "height", height or 1)
	setNoDataOutput(self, req, width or 1, height or 1)
end

--endregion PreCalcProcess

--region Process
function Process(req)
	logInfo("[process] Start", "time", req.Time, "precalc", req:IsPreCalc(), "quick", req:IsQuick(), "noMotionBlur",
		req:IsNoMotionBlur())
	local pathValue = InInputPath:GetValue(req)
	local inputPath = pathValue and pathValue.Value or ""
	local mappedPath = mapCompPath(self.Comp, inputPath)
	logInfo("[process] Path values", "input", inputPath, "mapped", mappedPath)

	if req:IsPreCalc() then
		local width, height = resolveVideoSize(req, self.Comp)
		logInfo("[process] Precalc request", "width", width or 1, "height", height or 1)
		setNoDataOutput(self, req, width or 1, height or 1)
		return
	end

	if mappedPath == "" then
		logInfo("[process] No mapped path")
		LOADER_INFO_STATUS_KEY = nil
		setStatusHtml(makeStatusHtml("No video loaded", { "Choose a video path." }, false))
		setBlankOutput(self, req, 1, 1)
		return
	end

	if not fileExists(mappedPath) then
		logInfo("[process] Missing input file", mappedPath)
		setErrorStatus("Input file missing", mappedPath)
		setBlankOutput(self, req, 1, 1)
		return
	end

	local decoder, err = ensureDecoder(mappedPath)
	if not decoder then
		logInfo("[process] Decoder unavailable", tostring(err))
		setErrorStatus("LibAV load/open failed", err)
		setBlankOutput(self, req, 1, 1)
		return
	end

	local frameIndex, blank, nextFrameIndex, interpolation = computeFrameIndex(req, decoder.info, self.Comp)
	local outputFormat, outputDepth, bytesPerPixel, outputFormatName = getOutputFormat(req)
	local outputWidth, outputHeight = getOutputDimensions(decoder.info, req)
	local _, outputScaling = getOutputScale(req)
	logInfo("[process] Frame decision", "time", req.Time, "frameIndex", frameIndex, "blank", blank, "scaling",
		outputScaling)
	if blank then
		logInfo("[process] Blank frame requested")
		setBlankOutput(self, req, outputWidth, outputHeight)
		setInfoStatus(decoder.info, mappedPath, {
			decodePath = "Blank frame",
			outputFormat = outputFormatName,
			outputScaling = outputScaling,
			outputSize = string.format("%d x %d", outputWidth, outputHeight),
		})
		return
	end

	local outImg = createImage(self, req, outputWidth, outputHeight, false, outputDepth)
	logInfo("[process] Created output image", "width", outputWidth, "height",
		outputHeight, "depth", outputDepth, "format", outputFormatName, "hasGetScanLine",
		outImg.GetScanLine ~= nil)
	if not outImg.GetScanLine then
		setErrorStatus("Image output failed", "Fusion Image:GetScanLine is unavailable")
		setBlankOutput(self, req, outputWidth, outputHeight)
		return
	end

	logInfo("[process] Direct decoding frame", frameIndex)
	local frame, decodePath, fallbackReason = decodeFrameToImage(decoder, frameIndex, outImg, outputFormat, bytesPerPixel,
		outputWidth, outputHeight)
	if logEnabled() then
		logInfo("[process] Frame decode result", "ok", frame ~= nil, "path", tostring(decodePath), "err",
			tostring(fallbackReason), "bridgeDebug",
			LOADER_LIBAV.lastDebug and LOADER_LIBAV.lastDebug() or "")
	end
	if not frame then
		setErrorStatus("Frame decode failed", fallbackReason)
		setBlankOutput(self, req, outputWidth, outputHeight)
		return
	end

	if interpolation > 0 and nextFrameIndex ~= frameIndex then
		local nextImg = createImage(self, req, outputWidth, outputHeight, false, outputDepth)
		local nextFrame, nextDecodePath, nextFallbackReason = decodeFrameToImage(decoder, nextFrameIndex, nextImg,
			outputFormat, bytesPerPixel, outputWidth, outputHeight)
		if not nextFrame then
			setErrorStatus("Interpolation frame decode failed", nextFallbackReason)
			setBlankOutput(self, req, outputWidth, outputHeight)
			return
		end
		local blended, blendErr = blendImages(outImg, nextImg, outputWidth, outputHeight, bytesPerPixel, interpolation)
		if not blended then
			setErrorStatus("Interpolation failed", blendErr)
			setBlankOutput(self, req, outputWidth, outputHeight)
			return
		end
		decodePath = decodePath .. " + " .. nextDecodePath .. " + Linear blend"
		fallbackReason = fallbackReason or nextFallbackReason
	end

	setInfoStatus(decoder.info, mappedPath, {
		decodePath = decodePath,
		outputFormat = outputFormatName,
		outputScaling = outputScaling,
		outputSize = string.format("%d x %d", tonumber(frame.width) or 0, tonumber(frame.height) or 0),
		stride = tonumber(frame.stride),
		fallbackReason = fallbackReason,
	})

	logInfo("[process] Setting output", "time", req.Time, "frameIndex", frameIndex, "reportedFrame",
		tonumber(frame.frame_index), "width", tonumber(frame.width), "height", tonumber(frame.height))
	OutImage:Set(req, outImg)
	logInfo("[process] Done", "time", req.Time, "frameIndex", frameIndex)
end

--endregion Process

--region Tests
function Tests()
	local failures = 0

	local function ok(name, condition)
		if condition then
			logInfo("[tests] OK", name)
		else
			failures = failures + 1
			logCritical("[tests] FAIL", name)
		end
	end

	ok("clamp low", clamp(-1, 0, 2) == 0)
	ok("clamp high", clamp(3, 0, 2) == 2)
	ok("umod negative", umod(-1, 4) == 3)
	ok("pingpong forward", pingpong(3, 4) == 3)
	ok("pingpong reverse", pingpong(4, 4) == 2)
	ok("html escape", escapeHtml([[<&">]]) == "&lt;&amp;&quot;&gt;")
	ok("frame count estimate", getInfoFrameCount({ frameCount = 0, duration = 2, fps = 24 }) == 48)

	if failures > 0 then
		logError(failures, "test(s) failed")
	end

	logInfo("[tests] All tests passed")
end

if not RUNNING_IN_FUSION and TOOL_RUN_TESTS_ON_STARTUP then
	Tests()
end
--endregion Tests
